generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Кожна стаття, яку вже бачили. Унікальний url = захист від дублів.
model Article {
  id          Int       @id @default(autoincrement())
  url         String    @unique
  title       String
  source      String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  // що з нею сталося: sent | rejected_rules | rejected_ai
  status      String    @default("sent")
  score       Int?      // оцінка GPT 1–10
  stream      String?   // потік контенту (новинки, ресурси, заробіток…)
  account     String?   // creators | tools | knowledge
  reason      String?   // чому така оцінка / чому відсіяно правилами
  post        String?   // текст надісланого поста — для тижневих добірок
  storyScore  Int?      // 0–10: наскільки з цієї статті вийде вау-історія (герой, цифри, поворот)
  hook        String?   // 🪝 короткий пост-гачок для Threads (лише для оцінок HOOK_SCORE+)
  tags        String?   // 1–2 хештеги через пробіл, напр. "#заробіток #YouTube"
}

// Пости про SkyNovix (режим promo): для ротації тем і щоб не повторювати товари й думки.
model PromoPost {
  id         Int      @id @default(autoincrement())
  theme      String   // fees | checkout | what_to_sell | trust | positioning | tips
  text       String   // усі частини, через "\n\n---\n\n"
  productUrl String?  // для постів про конкретний товар
  createdAt  DateTime @default(now())
}

// Кожен надісланий у бот пост — щоб зіставити твою реакцію (👍) з постом.
model SentMessage {
  id        Int       @id @default(autoincrement())
  messageId Int       @unique // message_id у Telegram
  format    String    // news | tools | story | evergreen | saves
  title     String
  url       String?   // оригінал статті (для добірок — немає)
  source    String?
  account   String?
  score     Int?
  reaction  String?   // останній емодзі-реакція власника; null — реакції немає
  reactedAt DateTime?
  createdAt DateTime  @default(now())
}

// Дрібні службові значення між запусками (напр. offset для getUpdates).
model BotState {
  key   String @id
  value String
}

// Що вже потрапляло в добірки (інструменти, ресурси) — щоб не повторювати тиждень у тиждень.
model FeaturedItem {
  id         Int      @id @default(autoincrement())
  key        String   // напр. "github:owner/repo", "hf:owner/space", "article:<url>"
  format     String   // tools | saves | story | evergreen
  featuredAt DateTime @default(now())

  @@unique([key, format])
}

// Який формат за який період уже вийшов — повторний запуск не надішле його двічі.
model FormatRun {
  id        Int      @id @default(autoincrement())
  format    String   // tools | saves | story | evergreen
  period    String   // напр. "2026-W41:tools"
  createdAt DateTime @default(now())

  @@unique([format, period])
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Кожна стаття, яку вже бачили. Унікальний url = захист від дублів.
model Article {
  id          Int       @id @default(autoincrement())
  url         String    @unique
  title       String
  source      String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  // що з нею сталося: sent | rejected_rules | rejected_ai | skipped
  status      String    @default("sent")
  score       Int?      // оцінка GPT 1–10
  stream      String?   // потік контенту (новинки, ресурси, заробіток…)
  account     String?   // creators | tools | knowledge
  reason      String?   // чому така оцінка / чому відсіяно правилами
}

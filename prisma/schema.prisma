generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Кожна стаття, яку вже бачили. Унікальний url = захист від дублів.
model Article {
  id          Int       @id @default(autoincrement())
  url         String    @unique
  title       String
  source      String
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}
